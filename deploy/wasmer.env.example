# Copy values into Wasmer Settings > Environment Vars. Never commit real secrets.
# Deployment preparation only: complete WASMER_DEPLOYMENT.md staging checks first.
NODE_ENV=production
HOST=0.0.0.0
# Use the HTTP port assigned/configured for the Wasmer app.
PORT=8080
DB_CLIENT=mysql
# Managed MySQL injects DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD.
# Do not replace those with localhost values or your local database credentials.
FRONTEND_URL=https://hirenextai.com
BACKEND_URL=https://hirenextai.com
GOOGLE_CALLBACK_URL=https://hirenextai.com/api/auth/google/callback
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=support@hirenextai.com
SMTP_USER=
SMTP_PASSWORD=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set only to verified trusted Wasmer proxy addresses/hops after staging review.
TRUST_PROXY=
