# Deployment values to merge into backend environment AFTER PostgreSQL migration.
# Do not copy over local backend/.env or start the current API with this alone.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=https://hirenextai.com
BACKEND_URL=https://hirenextai.com
GOOGLE_CALLBACK_URL=https://hirenextai.com/api/auth/google/callback
LINKEDIN_CALLBACK_URL=https://hirenextai.com/api/auth/linkedin/callback
# Assumes only local Nginx can connect to the API port.
TRUST_PROXY=loopback
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supply DATABASE_URL and DIRECT_URL through the deployment secret environment
# once the Express application's MySQL queries have been migrated.
